T3D_CONFIG_DIR=/config
T3D_STORAGE_DIR=/storage
# Windows UNC path corresponding to T3D_STORAGE_DIR, for example \\\\192.168.1.50\\3d\\storage
T3D_SMB_ROOT=
# Public NAS URL used by the Windows helper, for example http://192.168.1.50:8000
T3D_BASE_URL=
# auto: local path without SMB, or SMB when T3D_SMB_ROOT is set.
# Set explicitly to local or smb when required.
T3D_OPEN_MODE=auto
# Maximum source size rendered automatically into a PNG thumbnail during scan.
T3D_THUMBNAIL_MAX_SIZE_MB=5
# Maximum source size parsed by trimesh for cross-format fingerprints.
T3D_FINGERPRINT_MAX_SIZE_MB=100
